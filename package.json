{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "allowJs": true,
        "checkJs": true
    },
    "include": [
        "pages/**/*.js",
        "fixtures/**/*.js",
        "tests/**/*.js"
    ],
    "exclude": [
        "node_modules",
        "test-results",
        "playwright-report"
    ],
    "devDependencies": {
        "@playwright/test": "^1.64.1"
    }
}
